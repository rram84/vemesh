# Sriramajayam
@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/vemeshTargets.cmake")
check_required_components("@PROJECT_NAME@")

find_package(pmp REQUIRED)
find_package(eigen3 REQUIRED)
find_package(CLI11 REQUIRED)
find_package(Boost REQUIRED)
find_package(CGAL REQUIRED)

list(APPEND VM_INCLUDE_DIRS
  "@PACKAGE_VM_INCLUDE_DIRS_VAR@")

list(APPEND VM_LIBRARY_DIRS
  "@PACKAGE_VM_LIBRARY_DIRS_VAR@")

list(APPEND VM_LIBRARIES
  libvm_inspect.a
  libvm_io.a
  libvm_manager.a
  libvm_merge.a
  libvm_mesh_slicer.a
  libvm_move.a
  libvm_quality.a
  libvm_sampling.a
  libvm_spl_meshes.a
  libvm_stiffness.a
  libvm_tet_slicer.a
  libvm_vertex_ring.a
  libvm_visibility.a
  CGAL::CGAL
  Eigen3::Eigen
  pmp
  Boost::boost)
  
